{
  "name": "lease-decision-lab-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts": "openapi-typescript src/api/openapi.json -o src/api/generated.ts",
    "check": "tsc --noEmit",
